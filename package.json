{
  "name": "dsh-cot-translation-reader",
  "version": "0.1.3",
  "description": "Show the official COT machine translation inside dsh-better-display's reading view. · 在阅读视图里显示官方「思考过程机器翻译」的译文。",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LingMoe404/dsh-cot-translation-reader.git"
  },
  "homepage": "https://github.com/LingMoe404/dsh-cot-translation-reader#readme",
  "bugs": {
    "url": "https://github.com/LingMoe404/dsh-cot-translation-reader/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "translation",
    "better-display"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@types/node": "^22.20.0",
    "lightningcss": "^1.33.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
